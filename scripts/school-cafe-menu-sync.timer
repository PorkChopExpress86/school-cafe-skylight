# systemd USER timer for the weekly SchoolCafe menu sync.
#
# Triggers school-cafe-menu-sync.service every Sunday at 06:00 local time.
# Linger must be enabled (``loginctl enable-linger $USER``) for this to
# run unattended.

[Unit]
Description=Run school-cafe menu sync weekly on Sundays
Requires=school-cafe-menu-sync.service

[Timer]
OnCalendar=Sun *-*-* 06:00:00
Persistent=true
Unit=school-cafe-menu-sync.service

[Install]
WantedBy=timers.target
