# systemd USER unit for the weekly SchoolCafe menu sync.
#
# Runs ``python menu_sync.py`` every Sunday at 06:00 (local time). On
# failure, the script itself retries every 2 hours for 48 hours via
# ``_retry_loop`` — so a single transient network error doesn't lose
# the week.
#
# Install (one-time):
#     mkdir -p ~/.config/systemd/user
#     cp scripts/school-cafe-menu-sync.{service,timer} ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now school-cafe-menu-sync.timer
#
# Logs:
#     journalctl --user -u school-cafe-menu-sync.service -f

[Unit]
Description=School Cafe weekly menu sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/specter/dev/school-cafe-skylight/backend
ExecStart=/usr/bin/python3 menu_sync.py
# The script retries internally for 48 hours on failure, so we don't
# need a separate retry unit. But if the retry loop also fails, we
# record the failure in menu_sync_log so the admin page shows it.
TimeoutStartSec=48h
