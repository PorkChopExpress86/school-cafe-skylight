# Skylight Calendar — credentials
# Copy this file to `.env` and fill in real values.
# Required for scripts that talk to your Skylight account.

# Email used to sign in at https://app.ourskylight.com
SKYLIGHT_EMAIL=

# Skylight account password.
SKYLIGHT_PASSWORD=

# Default frame (household) ID. Most accounts have exactly one frame.
# Leave blank to auto-detect on first run — it will be printed so you can paste it back here.
SKYLIGHT_FRAME_ID=

# Optional: IANA timezone (e.g. America/New_York) for date queries.
# SKYLIGHT_TIMEZONE=

# SchoolCafé — only needed if you wire school_menu.py into this script.
SCHOOL_ID=
SCHOOL_SERVING_LINE=1
SCHOOL_MEAL_TYPE=Lunch
